-- ใส่โค้ดนี้ใน LocalScript (เช่น ใน StarterPlayerScripts หรือ StarterGui)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local playerToolEvent = ReplicatedStorage:WaitForChild("RE"):WaitForChild("PlayerToolEvent")

-- ตัวแปรสถานะ
local isScriptEnabled = true
local currentSongId = ""

-- ฟังก์ชันยิง RemoteEvent เล่นเพลง
local function playMusic(songId)
    if not isScriptEnabled then return end
    
    local args = {
        "ToolMusicText",
        tostring(songId),
        [4] = true
    }
    playerToolEvent:FireServer(unpack(args))
end

