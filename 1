-- ระบบการทำงานของปุ่มเปิด/ปิด (Toggle Switch)
toggleBtn.MouseButton1Click:Connect(function()
    isScriptEnabled = not isScriptEnabled
    
    local targetCirclePos = isScriptEnabled and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    local targetBgColor = isScriptEnabled and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(80, 80, 95)
    
    TweenService:Create(toggleCircle, TweenInfo.new(0.2), {Position = targetCirclePos}):Play()
    TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = targetBgColor}):Play()
    
    if isScriptEnabled then
        statusLabel.Text = "สถานะ: เปิดใช้งาน"
        statusLabel.TextColor3 = Color3.fromRGB(46, 213, 115)
        playBtn.AutoButtonColor = true
    else
        statusLabel.Text = "สถานะ: ปิดการทำงาน"
        statusLabel.TextColor3 = Color3.fromRGB(255, 71, 87)
        playBtn.AutoButtonColor = false
    end
end)

-- ระบบกดปุ่มส่งค่าเล่นเพลง
playBtn.MouseButton1Click:Connect(function()
    if not isScriptEnabled then
        statusLabel.Text = "สถานะ: กรุณาเปิดสวิตช์ก่อนใช้งาน"
        return
    end
    
    local songId = idInput.Text:match("%d+") -- กรองเฉพาะตัวเลข ID
    if songId and songId ~= "" then
        currentSongId = songId
        playingText.Text = "กำลังเล่น: ID " .. songId
        statusLabel.Text = "สถานะ: ส่งคำสั่งสำเร็จ"
        statusLabel.TextColor3 = Color3.fromRGB(46, 213, 115)
        playMusic(songId)
    else
        statusLabel.Text = "สถานะ: กรุณาใส่ ID ให้ถูกต้อง"
        statusLabel.TextColor3 = Color3.fromRGB(255, 71, 87)
    end
end)
